// Generated by tools/quest/make_scenes.py: lengths of the custom scene lines for the game's voice-over length
// table (the engine times subtitles and lines by it; ArchiveXL can't add to it). Same approach as
// Audioware's scene-dialog example. Every voice language has its own report, so all eleven get the lines.
// Needs Codeware.
module Slumlord

public class SlumlordSceneLineLengths extends ScriptableService {
  private cb func OnLoad() {
    let callback = GameInstance.GetCallbackSystem().RegisterCallback(n"Resource/PostLoad", this, n"OnPostLoad");
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\en-us\\stringidvariantlengthsreport.json"));
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\de-de\\stringidvariantlengthsreport.json"));
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\es-es\\stringidvariantlengthsreport.json"));
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\fr-fr\\stringidvariantlengthsreport.json"));
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\it-it\\stringidvariantlengthsreport.json"));
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\jp-jp\\stringidvariantlengthsreport.json"));
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\kr-kr\\stringidvariantlengthsreport.json"));
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\pl-pl\\stringidvariantlengthsreport.json"));
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\pt-br\\stringidvariantlengthsreport.json"));
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\ru-ru\\stringidvariantlengthsreport.json"));
    callback.AddTarget(ResourceTarget.Path(r"base\\localization\\zh-cn\\stringidvariantlengthsreport.json"));
  }

  private cb func OnPostLoad(event: ref<ResourceEvent>) {
    let resource = event.GetResource() as JsonResource;
    let map = IsDefined(resource) ? resource.root as locVoiceoverLengthMap : null;
    if !IsDefined(map) { return; }
    SlumlordSceneLineLengths.Add(map, 10237422524937244258ul, 6.43, 6.43);   // slumlord_co_standoff_01
    SlumlordSceneLineLengths.Add(map, 10237420325913987836ul, 6.75, 6.75);   // slumlord_co_standoff_03
    SlumlordSceneLineLengths.Add(map, 10237418126890731414ul, 6.51, 6.51);   // slumlord_co_standoff_05
    SlumlordSceneLineLengths.Add(map, 10237417027379103203ul, 1.71, 1.71);   // slumlord_co_standoff_06
    SlumlordSceneLineLengths.Add(map, 698807227767959884ul, 2.14, 2.14);   // slumlord_co_truce_01
    SlumlordSceneLineLengths.Add(map, 698810526302844517ul, 6.01, 6.01);   // slumlord_co_truce_02
    SlumlordSceneLineLengths.Add(map, 698803929233075251ul, 3.76, 3.76);   // slumlord_co_truce_04
    SlumlordSceneLineLengths.Add(map, 9166329559545131686ul, 2.30, 2.30);   // slumlord_fc_talk_01
    SlumlordSceneLineLengths.Add(map, 9166328460033503475ul, 1.89, 1.85);   // slumlord_fc_talk_02
    SlumlordSceneLineLengths.Add(map, 9166327360521875264ul, 8.40, 8.40);   // slumlord_fc_talk_03
    SlumlordSceneLineLengths.Add(map, 9166335057103272741ul, 1.28, 1.28);   // slumlord_fc_talk_04
    SlumlordSceneLineLengths.Add(map, 961256844586253376ul, 2.63, 2.63);   // slumlord_fc_flee_01
  }

  private static func Add(map: ref<locVoiceoverLengthMap>, id: Uint64, female: Float, male: Float) -> Void {
    let entry: locVoLengthEntry;
    entry.stringId = HashToCRUID(id);
    entry.femaleLength = female;
    entry.maleLength = male;
    ArrayPush(map.entries, entry);
  }
}
