# Slumlord: journal entries (Karl's texts, the boss quests), their texts, the world (quest pins, the motel scene's
# spots and communities), the motel quest phase (started once per save, loops) and its scene lines' subtitles.
journal:
  - slumlord\journal\slumlord.journal
localization:
  onscreens:
    en-us: slumlord\localization\en-us.json
  subtitles:
    en-us: slumlord\localization\en-us\subtitles\slumlord_subtitle_map.json
streaming:
  blocks:
    - slumlord\world\slumlord.streamingblock
quest:
  phases:
    - path: slumlord\quest\slumlord_motel.questphase
      parent: cyberpunk2077.quest
