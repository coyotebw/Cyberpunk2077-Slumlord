    "vpEntries": [
     {
      "$type": "scnlocLocStoreEmbeddedVariantPayloadEntry",
      "content": "Well, look who showed. Pretty ride, huh? Be a shame if somethin' happened to it.",
      "variantId": {
       "$type": "scnlocVariantId",
       "ruid": "10237422524937244262"
      }
     },
     {
      "$type": "scnlocLocStoreEmbeddedVariantPayloadEntry",
      "content": "Not actually mine.",
      "variantId": {
       "$type": "scnlocVariantId",
       "ruid": "1730300931073597444"
      }
     },
     {
      "$type": "scnlocLocStoreEmbeddedVariantPayloadEntry",
      "content": "Uh-huh. Here's the deal: you sign over Santo to me, and you ride outta here on your pretty little bike.",
      "variantId": {
       "$type": "scnlocVariantId",
       "ruid": "10237420325913987840"
      }
     },
     {
      "$type": "scnlocLocStoreEmbeddedVariantPayloadEntry",
      "content": "I'm serious.",
      "variantId": {
       "$type": "scnlocVariantId",
       "ruid": "1863268095561617412"
      }
     },
     {
      "$type": "scnlocLocStoreEmbeddedVariantPayloadEntry",
      "content": "Don't play dumb with me! My boys lifted it right outta your— ...Whose bike IS this?",
      "variantId": {
       "$type": "scnlocVariantId",
       "ruid": "10237418126890731418"
      }
     },
     {
      "$type": "scnlocLocStoreEmbeddedVariantPayloadEntry",
      "content": "Fuck it. Waste 'em!",
      "variantId": {
       "$type": "scnlocVariantId",
       "ruid": "10237417027379103207"
      }
     }
    ]
