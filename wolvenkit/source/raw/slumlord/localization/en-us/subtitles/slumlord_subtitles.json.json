  "RootChunk": {
   "$type": "JsonResource",
   "cookingPlatform": "PLATFORM_PC",
   "root": {
    "HandleId": "0",
    "Data": {
     "$type": "localizationPersistenceSubtitleEntries",
     "entries": [
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "Well, look who showed. Pretty ride, huh? Be a shame if somethin' happened to it.",
       "maleVariant": "",
       "stringId": "1014050488082468450"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "Not actually mine.",
       "maleVariant": "",
       "stringId": "1014049388570840239"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "Uh-huh. Here's the deal: you sign over Santo to me, and you ride outta here on your pretty little bike.",
       "maleVariant": "",
       "stringId": "1014048289059212028"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "I'm serious.",
       "maleVariant": "",
       "stringId": "1014047189547583817"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "Don't play dumb with me! My boys lifted it right outta your— ...Whose bike IS this?",
       "maleVariant": "",
       "stringId": "1014046090035955606"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "Fuck it. Waste 'em!",
       "maleVariant": "",
       "stringId": "1014044990524327395"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "Okay, okay! Truce, truce!",
       "maleVariant": "",
       "stringId": "698807227767959884"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "Look, these boys, what's left of 'em, they're good muscle. They're yours. Just let me walk.",
       "maleVariant": "",
       "stringId": "698810526302844517"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "Deal.",
       "maleVariant": "",
       "stringId": "698809426791216306"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "Pleasure doin' business, Mr. Landlord.",
       "maleVariant": "",
       "stringId": "698803929233075251"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "V. I told you we'd be seeing each other again.",
       "maleVariant": "",
       "stringId": "9166329559545131686"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "What the fuck…?",
       "maleVariant": "",
       "stringId": "9166328460033503475"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "I need this place to film a scene for Death Stranding 12. Now get lost, you're ruining the shot.",
       "maleVariant": "",
       "stringId": "9166327360521875264"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "Kill her!",
       "maleVariant": "Kill him!",
       "stringId": "9166335057103272741"
      },
      {
       "$type": "localizationPersistenceSubtitleEntry",
       "femaleVariant": "This isn't over, V!",
       "maleVariant": "",
       "stringId": "961256844586253376"
      }
     ]
    }
   }
  }
 }
}